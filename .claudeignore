# Fixtures, not source. These directories exist to prove the generator works across every
# supported platform, so they contain hundreds of generated guardrail files that look exactly
# like real ones. Keeping them out of the agent's view stops fixture output being mistaken for
# this repo's own configuration.
examples/basic/
examples/multimodule/
examples/multimodule-indexed/
load-tests/results/
oss-fuzz/
node_modules/

# Generated sidecars: one per module, regenerated on every compile, gitignored already.
.vibetags-mod-*
.vibetags-cache
vibetags.log

# Build output and snapshots.
target/
build/
pitest-report-*/

