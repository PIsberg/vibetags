<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherits every plugin and test-dependency version from the parent. Before it did,
         this pom sat on maven-compiler-plugin 3.13.0 against everyone else's 3.15.0,
         surefire 3.2.5 against 3.5.6, and declared junit.version=5.10.2 under the same
         property name vibetags used for 6.1.2. -->
    <parent>
        <groupId>se.deversity.vibetags</groupId>
        <artifactId>vibetags-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../vibetags-parent/pom.xml</relativePath>
    </parent>

    <artifactId>vibetags-load-tests</artifactId>
    <!-- Never released; deliberately not ${revision}, because this harness is version-agnostic
         and regularly built against an older processor to compare releases. -->
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>VibeTags Load Tests</name>
    <description>
        Standalone benchmark / load-test harness for the VibeTags annotation processor.
        Contains three categories of tests:
          1. Annotation-volume stress test  – sweeps N=10..10000 annotated classes compiled
             in-process via javax.tools.JavaCompiler and measures per-N overhead.
          2. JMH microbenchmarks            – hot-path benchmarks for writeFileIfChanged and
             buildServiceFileMap / resolveActiveServices with 1 KB and 64 KB file sizes.
          3. Concurrent-build safety test   – N threads compile against a shared output root
             to surface the absence of file-level locking in writeFileIfChanged.

        PREREQUISITE: install the processor into your local Maven repository first:
            cd ../vibetags &amp;&amp; mvn install -DskipTests

        Run stress + concurrent tests:
            mvn test

        Run JMH microbenchmarks (takes ~2 min):
            mvn package exec:java -Dexec.mainClass=org.openjdk.jmh.Main
    </description>

    <properties>
        <!-- The processor under test. The only version this pom owns, and it owns it on purpose:
             comparing releases means pointing the harness at an old one. CI overrides it with the
             version the run just built, so the regression gates test the branch rather than
             whatever this happens to say. -->
        <processor.version>${revision}</processor.version>
        <stress.max.classes>10000</stress.max.classes>
        <load.test.threads>4</load.test.threads>
    </properties>

    <dependencies>
        <!-- The processor under test -->
        <dependency>
            <groupId>se.deversity.vibetags</groupId>
            <artifactId>vibetags-processor</artifactId>
            <version>${processor.version}</version>
        </dependency>

        <!-- JMH – microbenchmark framework. Version from the parent (jmh.version). -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test framework -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler: annotation processing is ON here (needed for JMH code-gen) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <!-- JMH annotation processor generates benchmark boilerplate. Error Prone and
                         NullAway sit beside it rather than behind -proc:none as in vibetags-cli:
                         this module's whole harness is generated by that processor, so switching
                         annotation processing off would leave nothing to benchmark. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- Error Prone runs only on main sources, as in every other module. -->
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                                <!-- UnsafeFinalization references a javac class removed in JDK 26;
                                     off in every module, and BuildToolchainParityTest keeps the
                                     set identical across them. -->
                                <!-- ExcludedClassAnnotations is this module's one local judgement.
                                     A JMH @State class is constructed by the harness and filled in
                                     a @Setup method, so NullAway reads every benchmark field as an
                                     uninitialised @NonNull: 20 errors, all of them the lifecycle
                                     rather than a defect. Initialising them in a constructor would
                                     move that work inside the measured region, which is the one
                                     thing a benchmark must not do. Scoped to the annotation, so an
                                     ordinary class in this module is still analysed. -->
                                <arg>-Xplugin:ErrorProne -Xep:UnsafeFinalization:OFF -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=se.deversity.vibetags -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:ExcludedClassAnnotations=org.openjdk.jmh.annotations.State -XepOpt:NullAway:UnannotatedSubPackages=se.deversity.vibetags.loadtest.jmh_generated</arg>
                                <arg>-XDshould-stop.ifError=FLOW</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire: run JUnit 5 tests; skip slow stress tests unless flag set -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Allow controlling concurrency depth and sweep ceiling via system properties -->
                    <systemPropertyVariables>
                        <load.test.threads>${load.test.threads}</load.test.threads>
                        <!-- stress.max.classes=500 skips N > 500 (used by CI to keep the job fast) -->
                        <stress.max.classes>${stress.max.classes}</stress.max.classes>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Shade: produce a fat-jar so JMH can be run with exec:java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>benchmarks</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- exec:java entry-point for running the fat-jar JMH benchmarks -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.openjdk.jmh.Main</mainClass>
                </configuration>
            </plugin>
            <!-- The static-analysis stack invariant 16 requires of every module that compiles
                 Java. This module had none of it until #805: BuildToolchainParityTest iterated a
                 hardcoded four-module list that load-tests was not in, so ~2000 lines of Java
                 deciding what every recorded baseline measured were never analysed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <configLocation>${project.basedir}/../checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <linkXRef>false</linkXRef>
                </configuration>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <rulesets>
                        <ruleset>${project.basedir}/../pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <!-- JMH's annotation processor generates a harness class per benchmark method
                         into target/generated-sources, and PMD reads compile source roots, so it
                         analyses them: 2273 of this module's first 2276 violations were in code
                         nobody here writes or can fix. No other module needed this because no
                         other module generates sources. -->
                    <excludeRoots>
                        <excludeRoot>${project.build.directory}/generated-sources/annotations</excludeRoot>
                        <excludeRoot>${project.build.directory}/generated-test-sources/test-annotations</excludeRoot>
                    </excludeRoots>

                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                            <goal>cpd-check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <includeTests>false</includeTests>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                    <!-- Find Security Bugs, as in every other module. It has little to find in a
                         benchmark, and it is here so that "the same stack everywhere" is one
                         sentence rather than a sentence with an exception. -->
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs-plugin.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
