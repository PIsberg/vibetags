<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Versions, plugin declarations and the publishing setup all live in the parent.
         relativePath keeps every subproject buildable straight from a checkout without
         installing the parent first, and flatten-maven-plugin (inherited) removes this
         parent from the POM that reaches Maven Central. -->
    <parent>
        <groupId>se.deversity.vibetags</groupId>
        <artifactId>vibetags-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../vibetags-parent/pom.xml</relativePath>
    </parent>

    <artifactId>vibetags-annotations</artifactId>
    <packaging>jar</packaging>

    <!-- Declared rather than inherited. Maven appends the child's artifactId to an inherited
         project url, and unlike the scm entries it ignores child.project.url.inherit.append.path
         here (verified on Maven 3.8.6), so inheriting produced .../vibetags/vibetags-annotations —
         a URL that does not exist. Every published POM before this parent declared its own url;
         this keeps that. -->
    <url>https://github.com/PIsberg/vibetags</url>

    <name>VibeTags Annotations</name>
    <description>
        VibeTags annotation classes (@AILocked, @AIContext, @AIDraft, @AIAudit,
        @AIIgnore, @AIPrivacy, @AICore, @AIPerformance). Zero third-party dependencies.
        All annotations use RetentionPolicy.SOURCE so they leave no trace in the
        consumer's compiled bytecode — this jar exists purely to give javac the
        symbols it needs at compile time.

        Pair this with vibetags-processor on the annotation-processor classpath:

        Maven:
            &lt;dependency&gt;
                &lt;groupId&gt;se.deversity.vibetags&lt;/groupId&gt;
                &lt;artifactId&gt;vibetags-annotations&lt;/artifactId&gt;
                &lt;version&gt;1.3.0&lt;/version&gt;
            &lt;/dependency&gt;

        Gradle:
            compileOnly 'se.deversity.vibetags:vibetags-annotations:1.3.1'
            annotationProcessor 'se.deversity.vibetags:vibetags-processor:1.3.1'
    </description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Annotation processing makes no sense for an annotation-only artifact.
                         Error Prone still runs: it is a javac plugin loaded off the processor
                         path, which -proc:none does not disable. -->
                    <compilerArgs>
                        <arg>-proc:none</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-proc:none</arg>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                                <!-- Mirrors vibetags/pom.xml, minus the three style checks that
                                     module turns off: none of them fires on annotation
                                     declarations, and leaving them on here means this module
                                     reports them if that ever changes.

                                     UnsafeFinalization references com.sun.tools.javac.code.Flags$Flag,
                                     removed in JDK 26; disable until Error Prone fixes it. Kept in
                                     sync with vibetags/pom.xml by BuildToolchainParityTest. -->
                                <arg>-Xplugin:ErrorProne -Xep:UnsafeFinalization:OFF -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=se.deversity.vibetags -XepOpt:NullAway:JSpecifyMode=true</arg>
                                <arg>-XDshould-stop.ifError=FLOW</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <rulesets>
                        <ruleset>${project.basedir}/../pmd-ruleset.xml</ruleset>
                    </rulesets>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                            <goal>cpd-check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <!-- Stable JPMS module name for modular consumers; changing it after 1.0 is breaking. -->
                            <Automatic-Module-Name>se.deversity.vibetags.annotations</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!--
                      This module IS the public API: 44 annotations whose members and enum constants
                      are what a consumer's IDE shows on hover and what lands on javadoc.io. A
                      missing @return or an undocumented enum constant leaves them guessing a
                      guardrail's meaning from its name.

                      Warnings were not fatal before, so 46 of them accumulated silently while the
                      javadoc jar kept building successfully. Making them fatal is what stops the
                      next annotation from re-opening the same gap.
                    -->
                    <doclint>all</doclint>
                    <failOnWarnings>true</failOnWarnings>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <configLocation>${project.basedir}/../checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <linkXRef>false</linkXRef>
                </configuration>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <includeTests>false</includeTests>
                    <failOnError>true</failOnError>
                    <!-- Find Security Bugs: adds ~140 security detectors (injection, crypto,
                         path traversal, XXE, deserialization) on top of the SpotBugs core set. -->
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs-plugin.version}</version>
                        </plugin>
                    </plugins>
                    <!-- No excludeFilterFile. This module compiles to 44 annotation interfaces and
                         two enums with no method bodies, and the gate is clean without one. Add a
                         spotbugs-exclude.xml here only when a finding actually needs excusing, so
                         the absence of the file stays evidence that nothing has been excused. -->
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- SBOM: generates CycloneDX BOM at package phase, attached as classifier "cyclonedx" -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>library</projectType>
                    <schemaVersion>1.6</schemaVersion>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeProvidedScope>false</includeProvidedScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeSystemScope>false</includeSystemScope>
                    <includeTestScope>false</includeTestScope>
                    <includeLicenseText>false</includeLicenseText>
                    <outputFormat>all</outputFormat>
                    <outputName>bom</outputName>
                </configuration>
            </plugin>
            <!-- Shipping-dependency allowlist; rule and rationale live in vibetags-parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
