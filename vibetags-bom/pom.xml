<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Versions, plugin declarations and the publishing setup all live in the parent.
         flatten-maven-plugin (inherited) removes this parent and resolves ${revision} before
         deploy, so the BOM on Maven Central stays a self-contained, parent-free POM. -->
    <parent>
        <groupId>se.deversity.vibetags</groupId>
        <artifactId>vibetags-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../vibetags-parent/pom.xml</relativePath>
    </parent>

    <artifactId>vibetags-bom</artifactId>
    <packaging>pom</packaging>

    <!-- Declared, not inherited: Maven appends the artifactId to an inherited project url. -->
    <url>https://github.com/PIsberg/vibetags</url>

    <name>VibeTags BOM</name>
    <description>
        Bill of Materials for the VibeTags annotation processor. Import this BOM to get
        a coherent vibetags-annotations + vibetags-processor pair without specifying
        each version individually.

        Recommended setup — annotations on the compile classpath, processor on the
        annotation-processor path only (the processor jar pulls in slf4j/logback,
        which has no business on consumer code's compileClasspath):

        Maven:
            &lt;dependencyManagement&gt;
                &lt;dependencies&gt;
                    &lt;dependency&gt;
                        &lt;groupId&gt;se.deversity.vibetags&lt;/groupId&gt;
                        &lt;artifactId&gt;vibetags-bom&lt;/artifactId&gt;
                        &lt;version&gt;1.0.0-RC10&lt;/version&gt;
                        &lt;type&gt;pom&lt;/type&gt;
                        &lt;scope&gt;import&lt;/scope&gt;
                    &lt;/dependency&gt;
                &lt;/dependencies&gt;
            &lt;/dependencyManagement&gt;

        Gradle:
            implementation platform('se.deversity.vibetags:vibetags-bom:1.0.0-RC10')
            annotationProcessor platform('se.deversity.vibetags:vibetags-bom:1.0.0-RC10')
            compileOnly 'se.deversity.vibetags:vibetags-annotations'
            annotationProcessor 'se.deversity.vibetags:vibetags-processor'
    </description>

    <build>
        <plugins>
            <!--
              flattenMode=bom, overriding the parent's ossrh. This is not a preference: ossrh mode
              DROPS <dependencyManagement>, and a BOM is nothing else. Published under ossrh this
              file resolved, imported cleanly, and managed zero dependencies — every consumer would
              have got "'dependencies.dependency.version' is missing" for vibetags-annotations and
              vibetags-processor, with a BOM that looked perfectly valid. Verified by reading the
              installed POM rather than trusting the build to say so.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>bom</flattenMode>
                    <pomElements>
                        <properties>remove</properties>
                    </pomElements>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- ${revision} comes from vibetags-parent and is resolved into a literal by
                 flatten-maven-plugin before deploy, so consumers importing this BOM see real
                 version numbers. There used to be a second source of truth here — a
                 vibetags.version property that had to be bumped in step with three other poms;
                 the release now moves one number in the parent. -->
            <dependency>
                <groupId>se.deversity.vibetags</groupId>
                <artifactId>vibetags-annotations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>se.deversity.vibetags</groupId>
                <artifactId>vibetags-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
