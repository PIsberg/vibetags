<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Versions, plugin declarations and the publishing setup all live in the parent.
         relativePath keeps every subproject buildable straight from a checkout without
         installing the parent first, and flatten-maven-plugin (inherited) removes this
         parent from the POM that reaches Maven Central. -->
    <parent>
        <groupId>se.deversity.vibetags</groupId>
        <artifactId>vibetags-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../vibetags-parent/pom.xml</relativePath>
    </parent>

    <artifactId>vibetags-cli</artifactId>
    <packaging>jar</packaging>

    <!-- Declared rather than inherited; see vibetags-annotations/pom.xml for why. -->
    <url>https://github.com/PIsberg/vibetags</url>

    <name>VibeTags CLI</name>
    <description>
        Companion command-line tool for VibeTags: `init` bootstraps a project's opt-in
        files (file presence is the opt-in signal the processor honours), `doctor`
        reports the project's VibeTags health — build-tool wiring, active platforms,
        marker integrity. Run it without installing anything:

            jbang se.deversity.vibetags:vibetags-cli:1.2.2 init --list

        The platform list and marker rules are read from vibetags-processor, so this
        tool cannot drift from what the processor actually does.
    </description>

    <dependencies>
        <!-- ServiceRegistry (the opt-in platform list), GuardrailFileWriter (marker
             constants). One source of truth: the CLI must never carry its own copy. -->
        <dependency>
            <groupId>se.deversity.vibetags</groupId>
            <artifactId>vibetags-processor</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The processor is on the compile classpath as a library; running it
                         over the CLI's own sources would need an opted-in file layout this
                         module does not have. Error Prone still runs: it is a javac plugin
                         loaded off the processor path, which -proc:none does not disable. -->
                    <compilerArgs>
                        <arg>-proc:none</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- Error Prone runs only on main sources; test sources skip it -->
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-proc:none</arg>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                                <!-- Mirrors vibetags/pom.xml. The CLI prints to stdout by design,
                                     so StringConcatToTextBlock and StatementSwitchToExpressionSwitch
                                     are off here for the same reason they are off there: the string
                                     literals are output the user reads, where an explicit \n beats a
                                     text block whose indentation is a rendering bug waiting to
                                     happen.

                                     UnsafeFinalization references com.sun.tools.javac.code.Flags$Flag,
                                     removed in JDK 26; disable until Error Prone fixes it. Kept in
                                     sync with vibetags/pom.xml by BuildToolchainParityTest. -->
                                <arg>-Xplugin:ErrorProne -Xep:UnsafeFinalization:OFF -Xep:StatementSwitchToExpressionSwitch:OFF -Xep:StringConcatToTextBlock:OFF -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=se.deversity.vibetags -XepOpt:NullAway:JSpecifyMode=true</arg>
                                <arg>-XDshould-stop.ifError=FLOW</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <rulesets>
                        <ruleset>${project.basedir}/../pmd-ruleset.xml</ruleset>
                    </rulesets>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                            <goal>cpd-check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- Implementation-Version is how the CLI knows its own version
                                 at runtime (Main.version()); jbang and java -jar both read
                                 Main-Class. -->
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <mainClass>se.deversity.vibetags.cli.Main</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Automatic-Module-Name>se.deversity.vibetags.cli</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <configLocation>${project.basedir}/../checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <linkXRef>false</linkXRef>
                </configuration>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <includeTests>false</includeTests>
                    <failOnError>true</failOnError>
                    <!-- Find Security Bugs: adds ~140 security detectors (injection, crypto,
                         path traversal, XXE, deserialization) on top of the SpotBugs core set.
                         It matters more here than anywhere else in the repo: this is the only
                         module that takes argv from a user and turns it into filesystem writes. -->
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs-plugin.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- SBOM: generates CycloneDX BOM at package phase, attached as classifier "cyclonedx" -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>application</projectType>
                    <schemaVersion>1.6</schemaVersion>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeProvidedScope>false</includeProvidedScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                    <includeSystemScope>false</includeSystemScope>
                    <includeTestScope>false</includeTestScope>
                    <includeLicenseText>false</includeLicenseText>
                    <outputFormat>all</outputFormat>
                    <outputName>bom</outputName>
                </configuration>
            </plugin>
            <!-- Shipping-dependency allowlist; rule and rationale live in vibetags-parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
